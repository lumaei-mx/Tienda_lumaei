# === CJ Dropshipping (elige UNA forma de auth) ===
# Opción A (recomendada): API Key → se obtiene access token automático
CJ_API_KEY=

# Opción B: access token directo (JWT)
# CJ_ACCESS_TOKEN=

# Opción C: refresh token
# CJ_REFRESH_TOKEN=

CJ_API_BASE=https://developers.cjdropshipping.com/api2.0/v1

# true = órdenes sandbox (sin cobro real en CJ)
CJ_SANDBOX=true

# true = paga con balance CJ al crear orden (¡dinero real!)
CJ_AUTO_PAY_BALANCE=false

# Markup sobre (costo + envío estimado) para precio venta
CJ_DEFAULT_MARKUP=2.6

# País origen envío
CJ_FROM_COUNTRY=CN
CJ_DEFAULT_LOGISTIC=CJPacket Ordinary

# Stripe (pagos cliente)
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=whsec_...  # para verificar firma en /api/stripe/webhook

# === Email transaccional (confirmación de pedido al cliente, vía Resend) ===
# Sin estas variables el envío se omite (no rompe el checkout).
# RESEND_API_KEY=re_...
# EMAIL_FROM=Lumaei <no-reply@lumaei.shop>
# NEXT_PUBLIC_SITE_URL=https://lumaei.shop  # base para link "Ver mi pedido"

# === Firestore (persistencia en producción) ===
# Opción A: ruta al JSON de service account (local)
# GOOGLE_APPLICATION_CREDENTIALS=/Users/tu/service-account.json

# Opción B: vars separadas (Vercel)
# FIREBASE_PROJECT_ID=gptcall-416910
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@gptcall-416910.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Opción C: JSON completo en una sola var (Vercel)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# ==== Almacenamiento (producción) ====
# REDIS_URL=redis://default:password@host:port

# ==== Admin y crons (NUNCA commitear valores reales) ====
# ADMIN_PASSWORD=
# ADMIN_SECRET=
# CRON_SECRET=
# CJ_WEBHOOK_SECRET=  (obligatorio: /api/cj/webhook rechaza 503 si no está definido; configurar header x-cj-webhook-secret en el panel CJ)
